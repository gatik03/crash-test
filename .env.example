# Copy to .env and fill in. Never commit .env.
PORT=3000

# Payment rail: `mock` (default, no keys needed) or `paypal-sandbox`.
PAYPAL_RAIL=mock
# PayPal: sandbox only. Any other value is rejected when PAYPAL_RAIL=paypal-sandbox.
PAYPAL_ENV=sandbox
# Sandbox REST app credentials (developer.paypal.com → Apps & Credentials, Sandbox).
# Required only for PAYPAL_RAIL=paypal-sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Printed by `pnpm spike:vault` after the one-time buyer approval. Required for paypal-sandbox.
WALLET_VAULT_ID=

# SQLite file; the parent directory is created on boot.
DATABASE_PATH=data/crash-test.db

# LLM (agent under test, judge, variant generator). Provider: gemini or nvidia.
LLM_PROVIDER=gemini
# Google AI Studio key or nvapi-... key. Never commit.
LLM_API_KEY=
# Optional override of the preset base URL.
LLM_BASE_URL=
# Shared requests-per-minute limit across all roles.
LLM_MAX_RPM=10
# Model ids per role; default gemini-2.5-flash when LLM_PROVIDER=gemini (required for nvidia).
LLM_MODEL_AGENT=
LLM_MODEL_JUDGE=
LLM_MODEL_GENERATOR=

# Orchestrator and hosting (ARCHITECTURE 5.7, 5.8, 9).
# `public` makes trials > 1 admin-only and trusts one proxy hop for client IPs.
DEMO_MODE=local
# Bearer token for admin-only requests (min 16 chars). Never commit.
ADMIN_TOKEN=
ALLOW_LIVE_RUNS=true
LIVE_RUNS_PER_IP_PER_DAY=3
LIVE_RUNS_GLOBAL_PER_DAY=30
# Refund whatever is still captured after each scenario's ledger snapshot.
CLEANUP_REFUNDS_DEFAULT=true
RUN_CONCURRENCY=2
