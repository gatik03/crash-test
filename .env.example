# Copy to .env and fill in. Never commit .env.
PORT=3000

# PayPal: sandbox only. Any other value is rejected.
PAYPAL_ENV=sandbox
# Sandbox REST app credentials (developer.paypal.com → Apps & Credentials, Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Printed by `pnpm spike:vault` after the one-time buyer approval.
WALLET_VAULT_ID=
