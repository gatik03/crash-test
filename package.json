{
  "name": "crash-test",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:shared": "pnpm --filter @crash-test/shared build",
    "dev": "pnpm build:shared && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @crash-test/server start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm build:shared && pnpm -r typecheck && tsc -p scripts",
    "test": "pnpm build:shared && vitest run",
    "test:sandbox": "pnpm build:shared && SANDBOX_TESTS=1 vitest run apps/server/src/rails/PayPalSandboxRail.test.ts",
    "check:sandbox-only": "node scripts/check-sandbox-only.ts",
    "spike:vault": "node --env-file=.env scripts/vault-wallet.ts",
    "spike": "node --env-file=.env scripts/spike-paypal.ts",
    "record:gold": "pnpm cli record-gold",
    "cli": "pnpm --filter @crash-test/server exec tsx --env-file=../../.env src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
